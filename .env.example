# Variáveis legadas para scripts CLI executados pelo proprietário.
# Sessões autenticadas do portal usam "Minhas credenciais" e ignoram estas chaves.
# .env fica local e é ignorado pelo Git; este exemplo não contém segredos.

# Alpaca Trading API: Key ID e Secret Key da conta individual.
# Usado apenas para dados de mercado IEX; endpoint Trading/Paper não é usado.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Binance Spot Testnet: somente conta virtual; nunca use chaves de produção.
BINANCE_SPOT_TESTNET_API_KEY=
BINANCE_SPOT_TESTNET_API_SECRET=

# Provedor de IA compatível com OpenAI (opcional).
TRADING_LAB_LLM_BASE_URL=
TRADING_LAB_LLM_MODEL=
TRADING_LAB_LLM_API_KEY=
